FROM jenkins/jenkins:lts

USER root

# Installer les dépendances de base
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    libatomic1 \
    git \
    && apt-get clean

# Installer Node.js 20 + npm
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Installer Docker CLI (pour Docker-in-Docker ou accès au socket Docker)
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian bullseye stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y docker-ce-cli \
    && apt-get clean

# Vérification des installations
RUN node -v && npm -v && docker --version && git --version

# Garder root pour permettre la correction des permissions
# Jenkins changera automatiquement d'utilisateur si nécessaire
USER root
