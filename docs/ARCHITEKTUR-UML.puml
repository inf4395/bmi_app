@startuml Architektur_Uebersicht
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho

package "Frontend (React + Vite)" {
    [Browser] as Browser
    [React App] as ReactApp
    [AuthContext] as AuthContext
    [Router] as Router
    [LoginPage] as LoginPage
    [RegisterPage] as RegisterPage
    [ProtectedRoute] as ProtectedRoute
    [Dashboard] as Dashboard
    [BmiCalculator] as BmiCalculator
    [Statistics] as Statistics
    [Programs] as Programs
    [Profile] as Profile
    [Navigation] as Navigation
    [localStorage] as LocalStorage
}

package "Backend (Express.js)" {
    [Express Server] as ExpressServer
    [AuthRoutes] as AuthRoutes
    [BmiRoutes] as BmiRoutes
    [StatsRoutes] as StatsRoutes
    [TestRoutes] as TestRoutes
    [AuthMiddleware] as AuthMiddleware
    [JWT Verification] as JWT
}

database "Datenbank (SQLite)" {
    [users] as Users
    [bmi_records] as BmiRecords
    [weight_goals] as WeightGoals
    [user_programs] as UserPrograms
}

Browser --> ReactApp
ReactApp --> AuthContext
ReactApp --> Router
Router --> LoginPage
Router --> RegisterPage
Router --> ProtectedRoute
ProtectedRoute --> Dashboard
ProtectedRoute --> BmiCalculator
ProtectedRoute --> Statistics
ProtectedRoute --> Programs
ProtectedRoute --> Profile
ReactApp --> Navigation
AuthContext --> LocalStorage

ReactApp -->|HTTP/REST| ExpressServer
ExpressServer --> AuthRoutes
ExpressServer --> BmiRoutes
ExpressServer --> StatsRoutes
ExpressServer --> TestRoutes
AuthRoutes --> AuthMiddleware
BmiRoutes --> AuthMiddleware
StatsRoutes --> AuthMiddleware
AuthMiddleware --> JWT

AuthRoutes --> Users
BmiRoutes --> Users
BmiRoutes --> BmiRecords
StatsRoutes --> Users
StatsRoutes --> BmiRecords
StatsRoutes --> WeightGoals
TestRoutes --> Users
TestRoutes --> BmiRecords
TestRoutes --> WeightGoals
TestRoutes --> UserPrograms

@enduml

@startuml Frontend_Komponenten
!theme plain
skinparam classAttributeIconSize 0

class App {
    +Routes routes
    +render() void
}

class AuthContext {
    -user: Object
    -token: String
    -loading: Boolean
    -error: String
    +login(email: String, password: String): Promise
    +register(name: String, email: String, password: String): Promise
    +logout(): void
    +updateUser(user: Object): void
    +clearError(): void
}

class ProtectedRoute {
    +children: Component
    +checkAuth(): Boolean
    +redirectToLogin(): void
}

class Navigation {
    +links: Array
    +handleLogout(): void
    +render(): JSX
}

class LoginPage {
    -formData: Object
    +handleSubmit(): void
    +handleChange(): void
    +render(): JSX
}

class RegisterPage {
    -formData: Object
    +handleSubmit(): void
    +handleChange(): void
    +render(): JSX
}

class Dashboard {
    -user: Object
    +fetchUserData(): void
    +render(): JSX
}

class BmiCalculator {
    -formData: Object
    -result: Object
    +handleSubmit(): void
    +handleChange(): void
    +calculateBMI(): void
    +render(): JSX
}

class Statistics {
    -stats: Object
    -chartData: Array
    +fetchStatistics(): void
    +render(): JSX
}

class Programs {
    -programs: Array
    +fetchPrograms(): void
    +createProgram(): void
    +render(): JSX
}

class Profile {
    -user: Object
    -formData: Object
    +updateProfile(): void
    +render(): JSX
}

App --> AuthContext : uses
App --> ProtectedRoute : uses
App --> LoginPage : routes to
App --> RegisterPage : routes to
ProtectedRoute --> Dashboard : protects
ProtectedRoute --> BmiCalculator : protects
ProtectedRoute --> Statistics : protects
ProtectedRoute --> Programs : protects
ProtectedRoute --> Profile : protects
LoginPage --> AuthContext : uses
RegisterPage --> AuthContext : uses
Dashboard --> AuthContext : uses
BmiCalculator --> AuthContext : uses
Statistics --> AuthContext : uses
Programs --> AuthContext : uses
Profile --> AuthContext : uses
Dashboard --> Navigation : contains
BmiCalculator --> Navigation : contains
Statistics --> Navigation : contains
Programs --> Navigation : contains
Profile --> Navigation : contains

@enduml

@startuml Backend_Architektur
!theme plain
skinparam classAttributeIconSize 0

class ExpressServer {
    -app: Express
    -PORT: Number = 3000
    +useCORS(): void
    +useJSON(): void
    +registerRoutes(): void
    +startServer(): void
}

class AuthRoutes {
    -router: Router
    +register(db: Database): Router
    +login(db: Database): Router
    +getMe(db: Database): Router
    -hashPassword(password: String): String
    -verifyPassword(password: String, hash: String): Boolean
    -generateToken(user: Object): String
}

class BmiRoutes {
    -router: Router
    +calculateBMI(db: Database): Router
    +getBMIHistory(db: Database): Router
    -validateBMIInput(data: Object): Boolean
}

class StatsRoutes {
    -router: Router
    +getSummary(db: Database): Router
    +getDetailedStats(db: Database): Router
    -aggregateData(db: Database): Object
}

class TestRoutes {
    -router: Router
    +testDatabase(db: Database): Router
    +testConnection(db: Database): Router
}

class AuthMiddleware {
    +verifyToken(token: String): Object
    +extractToken(req: Request): String
    +authenticate(req: Request, res: Response, next: Function): void
}

class Database {
    -db: SQLiteDatabase
    +initDB(): Database
    +createTables(): void
    +exec(query: String): void
    +all(query: String): Array
    +get(query: String): Object
    +run(query: String): Result
}

class CalculateBMI {
    +calculate(weight: Number, height: Number): Number
    +getStatus(bmi: Number): String
    +getCategory(bmi: Number): String
}

ExpressServer --> AuthRoutes : uses
ExpressServer --> BmiRoutes : uses
ExpressServer --> StatsRoutes : uses
ExpressServer --> TestRoutes : uses
AuthRoutes --> Database : queries
BmiRoutes --> Database : queries
StatsRoutes --> Database : queries
TestRoutes --> Database : queries
AuthRoutes --> AuthMiddleware : uses
BmiRoutes --> AuthMiddleware : uses
StatsRoutes --> AuthMiddleware : uses
BmiRoutes --> CalculateBMI : uses

@enduml

@startuml Datenbankmodell
!theme plain
skinparam linetype ortho

entity "users" {
    * id : INTEGER <<PK>>
    --
    * name : TEXT
    * email : TEXT <<UK>>
    * password : TEXT
    gender : TEXT
    birth_date : DATE
    height : REAL
    created_at : DATETIME
}

entity "bmi_records" {
    * id : INTEGER <<PK>>
    --
    name : TEXT
    email : TEXT
    age : INTEGER
    height : REAL
    weight : REAL
    bmi : REAL
    status : TEXT
    * user_id : INTEGER <<FK>>
    created_at : DATETIME
}

entity "weight_goals" {
    * id : INTEGER <<PK>>
    --
    * user_id : INTEGER <<FK>>
    * target_weight : REAL
    * current_weight : REAL
    target_date : DATE
    status : TEXT
    created_at : DATETIME
}

entity "user_programs" {
    * id : INTEGER <<PK>>
    --
    * user_id : INTEGER <<FK>>
    * program_type : TEXT
    * program_name : TEXT
    description : TEXT
    start_date : DATE
    end_date : DATE
    status : TEXT
    created_at : DATETIME
}

users ||--o{ bmi_records : "hat"
users ||--o{ weight_goals : "hat"
users ||--o{ user_programs : "hat"

@enduml

@startuml Authentifizierung_Sequenz
!theme plain
autonumber

actor Benutzer
participant "Frontend" as Frontend
participant "AuthContext" as Auth
participant "Backend" as Backend
participant "Datenbank" as DB

Benutzer -> Frontend: Öffnet Login-Seite
Benutzer -> Frontend: Gibt Email/Passwort ein
Benutzer -> Frontend: Klickt "Anmelden"
Frontend -> Auth: login(email, password)
Auth -> Backend: POST /api/auth/login
Backend -> DB: SELECT user WHERE email
DB --> Backend: User-Daten
Backend -> Backend: verifyPassword()
Backend -> Backend: generateToken()
Backend --> Auth: {user, token}
Auth -> Auth: persistAuthState()
Auth -> Auth: setUser(user)
Auth --> Frontend: Authentifizierung erfolgreich
Frontend -> Frontend: Navigiere zu Dashboard

@enduml

@startuml BMI_Berechnung_Sequenz
!theme plain
autonumber

actor Benutzer
participant "BmiCalculator" as Frontend
participant "AuthContext" as Auth
participant "Backend" as Backend
participant "CalculateBMI" as Calc
participant "Datenbank" as DB

Benutzer -> Frontend: Gibt Gewicht/Größe ein
Benutzer -> Frontend: Klickt "Berechnen"
Frontend -> Auth: getToken()
Auth --> Frontend: JWT Token
Frontend -> Backend: POST /api/bmi (mit Token)
Backend -> Backend: AuthMiddleware.verifyToken()
Backend -> Backend: extractUserFromToken()
Backend -> Calc: calculate(weight, height)
Calc --> Backend: {bmi, status, category}
Backend -> DB: INSERT INTO bmi_records
DB --> Backend: Record erstellt
Backend --> Frontend: {bmi, status, category, ...}
Frontend -> Frontend: Zeige Ergebnis

@enduml

@startuml Deployment_Architektur
!theme plain
skinparam componentStyle rectangle

package "CI/CD Pipeline" {
    [Git Push] as Git
    [GitHub/GitLab/Jenkins] as CI
    [Lint Stage] as Lint
    [Test Stage] as Test
    [Build Stage] as Build
    [E2E Test Stage] as E2E
    [Deploy Stage] as Deploy
}

package "Development" {
    [Docker Compose Dev] as DockerDev
    [Frontend Dev Server\nPort 5173] as FrontendDev
    [Backend Server\nPort 3000] as BackendDev
    [Vite HMR] as HMR
}

package "Production" {
    [Nginx] as Nginx
    [Frontend Build\nStatic Files] as FrontendProd
    [Node.js] as Node
    [Backend Server\nPort 3000] as BackendProd
    database "SQLite Database" as DB
}

Git --> CI
CI --> Lint
CI --> Test
CI --> Build
CI --> E2E
CI --> Deploy

DockerDev --> FrontendDev
DockerDev --> BackendDev
FrontendDev --> HMR

Deploy --> Nginx
Deploy --> Node
Nginx --> FrontendProd
Node --> BackendProd
FrontendProd --> BackendProd
BackendProd --> DB

@enduml

