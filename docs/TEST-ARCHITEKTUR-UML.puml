@startuml Test_Ausfuehrung_Sequenz
!theme plain
autonumber

participant "CI/CD Pipeline" as CI
participant "Frontend Tests" as FT
participant "Backend Tests" as BT
participant "E2E Tests" as E2E
participant "Backend Server" as BE
participant "Frontend Server" as FE

CI -> FT: npm test (Vitest)
CI -> BT: npm test (Jest)
FT --> CI: ✅ 11 Test-Dateien
BT --> CI: ✅ 7 Test-Dateien

CI -> BE: Start Backend (Port 3000)
CI -> FE: Start Frontend (Port 5173)
BE --> CI: ✅ Server Ready
FE --> CI: ✅ Server Ready

CI -> E2E: npx playwright test
E2E -> BE: HTTP Requests
E2E -> FE: Browser Automation
E2E --> CI: ✅ 3 Test-Dateien

@enduml

